# —— generic ——
TZ=America/New_York

# —— signal-api service ——
SIGNAL_API_BIND_ADDR=127.0.0.1
SIGNAL_API_PORT=8080
SIGNAL_API_MODE=native
SIGNAL_DATA_DIR=./signal-cli

# —— autopost service ——
AUTOPOST_DATA_DIR=./data

# your site feed
SITE_FEED_URL=https://yoursite.com/atom.xml
STATE_FILE=/data/state.json

# Signal sender (the linked account) and recipient (you)
SIGNAL_NUMBER=+1YOUR_SIGNAL_NUMBER
SIGNAL_TO=+1YOUR_PERSONAL_NUMBER

# optional free networks (leave blank to disable)
BSKY_HANDLE=
BSKY_PASSWORD=
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=
